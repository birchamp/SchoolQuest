{
  "name": "@schoolquest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var DEV_MODE:true",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply schoolquest --local",
    "db:migrate:remote": "wrangler d1 migrations apply schoolquest --remote",
    "db:seed:local": "wrangler d1 execute schoolquest --local --file=./seed/seed.sql",
    "db:reset-progress:local": "wrangler d1 execute schoolquest --local --file=../../tools/e2e/reset-progress.sql"
  },
  "dependencies": {
    "@schoolquest/ai": "workspace:*",
    "@schoolquest/domain": "workspace:*",
    "@schoolquest/fixtures": "workspace:*",
    "@schoolquest/planning-engine": "workspace:*",
    "@schoolquest/theme-language": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.23.1",
    "wrangler": "^4.40.0"
  }
}
