{
  "name": "schoolquest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @schoolquest/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:web": "pnpm --filter @schoolquest/web dev",
    "dev:api": "pnpm --filter @schoolquest/api dev",
    "dev:desktop": "pnpm --filter @schoolquest/desktop dev",
    "db:generate": "pnpm --filter @schoolquest/api db:generate",
    "db:migrate:local": "pnpm --filter @schoolquest/api db:migrate:local",
    "db:seed:local": "pnpm --filter @schoolquest/api db:seed:local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
